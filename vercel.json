{
  "version": 2,
  "rewrites": [
    {
      "source": "/v2/:path*",
      "destination": "/api/index.py"
    },
    {
      "source": "/dashboard",
      "destination": "/api/index.py"
    },
    {
      "source": "/docs",
      "destination": "/api/index.py"
    },
    {
      "source": "/openapi.json",
      "destination": "/api/index.py"
    }
  ]
}
